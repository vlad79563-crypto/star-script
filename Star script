local function getTarget()
   local target = nil
   local shortest = math.huge
   for _, player in ipairs(Players:GetPlayers()) do
      if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
         local partName = Settings.Hitbox
         if partName == "Nearest" then partName = "Head" end
         local part = player.Character:FindFirstChild(partName) or player.Character:FindFirstChild("Head")
         
         if part then
            local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
               local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
               if dist < shortest then
                  shortest = dist
                  target = player
               end
            end
         end
      end
   end
   return target
end

RunService.RenderStepped:Connect(function()
   local target = getTarget()
   if target and target.Character then
      local hitboxName = Settings.Hitbox
      if Settings.PreferBody and target.Character:FindFirstChild("Humanoid") and target.Character.Humanoid.Health < 30 then
         hitboxName = "HumanoidRootPart"
      end
      if hitboxName == "Nearest" then hitboxName = "Head" end
      
      local part = target.Character:FindFirstChild(hitboxName) or target.Character:FindFirstChild("Head")
      if part then
         Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
      end
   end

   local char = LocalPlayer.Character
   if char and char:FindFirstChild("HumanoidRootPart") then
      local hrp = char.HumanoidRootPart
      local isShooting = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
      
      if not (Settings.DisableWhileShooting and isShooting) then
         local yaw = 0
         if Settings.AADirection == "Spin" then
            yaw = (tick() * Settings.SpinTempo * 15) % 360
         elseif Settings.AADirection == "Backwards" then
            yaw = 180
         elseif Settings.AADirection == "Sideways" then
            yaw = 90
         elseif Settings.AADirection == "Jitter" then
            yaw = math.random(-Settings.JitterRange, Settings.JitterRange)
         end
         
         local pitchVal = 0
         if Settings.AAPitch == "Down" then
            pitchVal = math.rad(89)
         elseif Settings.AAPitch == "Up" then
            pitchVal = math.rad(-89)
         elseif Settings.AAPitch == "Random" then
            pitchVal = math.rad(math.random(-89, 89))
         end
         
         pcall(function()
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(pitchVal, math.rad(yaw), 0)
         end)
      end
   end
end)

